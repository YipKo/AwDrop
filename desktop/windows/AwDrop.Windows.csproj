<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AwDrop.Windows</AssemblyName>
    <Version>0.1.0</Version>
    <ApplicationIcon>..\..\winawdl\app\winawdl.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.20250829.1" />
    <EmbeddedResource Include="..\..\locales\*.json" LogicalName="AwDrop.Locales.%(Filename)%(Extension)" />
    <Content Include="..\..\winawdl\app\winawdl.ico" Link="AwDrop.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\winawdl\docs\logo.png" Link="AwDrop.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
