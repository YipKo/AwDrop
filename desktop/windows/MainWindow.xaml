<Window
    x:Class="AwDrop.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AwDrop.Windows"
    Title="AwDrop">
    <Grid x:Name="Shell" Background="{ThemeResource AwDropBackground}">
        <Grid x:Name="BackdropTint" IsHitTestVisible="False" Visibility="Collapsed"
              Background="{ThemeResource AwDropBackdropTint}" />
        <SplitView x:Name="SettingsView" PanePlacement="Right" DisplayMode="Overlay" OpenPaneLength="318"
                   PaneBackground="Transparent" PaneOpened="SettingsOpened" PaneClosed="SettingsClosed">
            <SplitView.Pane>
                <Border x:Name="SettingsSurface" CornerRadius="16,0,0,16" BorderThickness="1,0,0,0"
                        BorderBrush="{ThemeResource AwDropStroke}" Background="{ThemeResource AwDropPane}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style x:Key="SettingsLabelIcon" TargetType="FontIcon">
                                <Setter Property="FontSize" Value="16" />
                                <Setter Property="Foreground" Value="{ThemeResource AwDropMuted}" />
                                <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
                            </Style>
                        </ScrollViewer.Resources>
                        <StackPanel Padding="20" Spacing="18">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE713;" Style="{StaticResource SettingsLabelIcon}" FontSize="20" />
                                    <TextBlock x:Name="SettingsTitle" Style="{ThemeResource TitleTextBlockStyle}"
                                               AutomationProperties.HeadingLevel="Level1" />
                                </StackPanel>
                                <Button x:Name="CloseSettingsButton" Grid.Column="1" Click="CloseSettingsClicked">
                                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                                </Button>
                            </Grid>
                            <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch"
                                      SelectionChanged="LanguageChanged">
                                <ComboBox.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE774;" Style="{StaticResource SettingsLabelIcon}" />
                                        <TextBlock x:Name="LanguageLabel" />
                                    </StackPanel>
                                </ComboBox.Header>
                            </ComboBox>
                            <ComboBox x:Name="AppearanceBox" HorizontalAlignment="Stretch"
                                      SelectionChanged="AppearanceChanged">
                                <ComboBox.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE771;" Style="{StaticResource SettingsLabelIcon}" />
                                        <TextBlock x:Name="AppearanceLabel" />
                                    </StackPanel>
                                </ComboBox.Header>
                            </ComboBox>
                            <ToggleSwitch x:Name="ReduceMotionSwitch" Toggled="ReduceMotionChanged">
                                <ToggleSwitch.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE776;" Style="{StaticResource SettingsLabelIcon}" />
                                        <TextBlock x:Name="ReduceMotionLabel" />
                                    </StackPanel>
                                </ToggleSwitch.Header>
                            </ToggleSwitch>
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7F8;" Style="{StaticResource SettingsLabelIcon}" />
                                    <TextBlock x:Name="DeviceLabel" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBox x:Name="DeviceNameBox" Margin="24,0,0,0" MaxLength="63"
                                         KeyDown="DeviceNameKeyDown" />
                                <Button x:Name="SaveDeviceNameButton" Margin="24,0,0,0" Click="SaveDeviceNameClicked" />
                                <TextBlock x:Name="DeviceNameStatus" Margin="24,0,0,0" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" Style="{StaticResource SettingsLabelIcon}" />
                                    <TextBlock x:Name="ReceiveFolderLabel" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="ReceiveFolderPath" Margin="24,0,0,0" TextWrapping="Wrap" />
                                <Button x:Name="ChooseReceiveFolderButton" Margin="24,0,0,0" Click="ChooseReceiveFolderClicked" />
                                <TextBlock x:Name="ReceiveFolderStatus" Margin="24,0,0,0" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AskBeforeReceivingSwitch" Toggled="AskBeforeReceivingChanged">
                                <ToggleSwitch.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8BD;" Style="{StaticResource SettingsLabelIcon}" />
                                        <TextBlock x:Name="AskBeforeReceivingLabel" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ToggleSwitch.Header>
                            </ToggleSwitch>
                            <TextBlock x:Name="SettingsStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                       Visibility="Collapsed" />
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE701;" Style="{StaticResource SettingsLabelIcon}" />
                                    <TextBlock x:Name="AdapterLabel" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock x:Name="AdapterStatus" Margin="24,0,0,0" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" />
                                <Button x:Name="RefreshButton" Margin="24,0,0,0" Click="RefreshClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock x:Name="RefreshLabel" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </SplitView.Pane>
            <SplitView.Content>
                <ScrollViewer x:Name="MainScroller" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="MainGrid" Padding="22,20,22,70" MinHeight="{Binding ViewportHeight, ElementName=MainScroller}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="ms-appx:///AwDrop.png" Width="34" Height="34"
                                   AutomationProperties.AccessibilityView="Raw" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="DeviceTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PresenceLabel" FontSize="12" Foreground="{ThemeResource AwDropMuted}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <TextBlock x:Name="RadioLabel" FontSize="13" Foreground="{ThemeResource AwDropMuted}" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="RadioSwitch" MinWidth="0" OnContent="" OffContent="" IsEnabled="False" />
                            </StackPanel>
                            <Button x:Name="SettingsButton" Grid.Column="3" Click="SettingsClicked"
                                    Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0">
                                <FontIcon Glyph="&#xE713;" FontSize="16" />
                            </Button>
                            <Button x:Name="HideButton" Grid.Column="4" Click="HideClicked"
                                    Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0">
                                <FontIcon Glyph="&#xE70D;" FontSize="14" />
                            </Button>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="0,28,0,0" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE772;" FontSize="15" Foreground="{ThemeResource AwDropMuted}" />
                                <TextBlock x:Name="NearbyLabel" FontSize="13" Foreground="{ThemeResource AwDropMuted}"
                                           AutomationProperties.HeadingLevel="Level2" />
                            </StackPanel>
                            <Border Padding="14,12" CornerRadius="16" BorderThickness="1"
                                    BorderBrush="{ThemeResource AwDropStroke}" Background="{ThemeResource AwDropCard}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{ThemeResource AwDropWell}"
                                            BorderBrush="{ThemeResource AwDropStroke}" BorderThickness="1" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE701;" FontSize="20" Foreground="{ThemeResource AwDropMuted}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite">
                                        <TextBlock x:Name="NearbyTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="NearbyMessage" FontSize="13" Foreground="{ThemeResource AwDropMuted}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <local:TransferProgressView x:Name="TransferProgress" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Margin="0,22,0,0" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7C3;" FontSize="15" Foreground="{ThemeResource AwDropMuted}" />
                                <TextBlock x:Name="FilesLabel" FontSize="13" Foreground="{ThemeResource AwDropMuted}"
                                           AutomationProperties.HeadingLevel="Level2" />
                            </StackPanel>
                            <Border x:Name="DropArea" AllowDrop="True" DragOver="FilesDragOver" Drop="FilesDropped"
                                    Padding="14" MinHeight="126" CornerRadius="16"
                                    BorderThickness="1" BorderBrush="{ThemeResource AwDropStroke}"
                                    Background="{ThemeResource AwDropWell}">
                                <StackPanel Spacing="10" VerticalAlignment="Center">
                                    <TextBlock x:Name="DropHint" HorizontalAlignment="Center" FontSize="17"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <ListView x:Name="FilesList" SelectionMode="None" MaxHeight="180">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="8" ToolTipService.ToolTip="{Binding Path}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <Button Grid.Column="1" Tag="{Binding Path}" Click="RemoveFileClicked"
                                                            AutomationProperties.Name="{Binding RemoveLabel}">
                                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                        <Button x:Name="ChooseFilesButton" Style="{StaticResource AccentButtonStyle}" Click="ChooseFilesClicked"
                                                CornerRadius="10" Padding="13,7">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                                                <TextBlock x:Name="ChooseFilesLabel" FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ClearFilesButton" Click="ClearFilesClicked" />
                                    </StackPanel>
                                    <TextBlock x:Name="FileStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </SplitView.Content>
        </SplitView>
    </Grid>
</Window>
